<Window x:Class="LegionPulse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:LegionPulse.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Legion Pulse"
        Width="1450"
        Height="825"
        MinWidth="1120"
        MinHeight="700"
        Background="{DynamicResource AppBackgroundBrush}"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    
    <Border Background="{DynamicResource AppBackgroundBrush}">
        <Grid Margin="8,18,12,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}" CornerRadius="18" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Grid Margin="11,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="44" />
                    </Grid.RowDefinitions>

                    <Border Width="38" Height="38" CornerRadius="12" Background="{DynamicResource PrimaryMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Top">
                        <TextBlock Text="&#xE950;" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding NavigationItems}" VerticalAlignment="Top" Margin="0,12,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <controls:NavigationItemControl Margin="0,0,0,13" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Grid.Row="2" Width="38" Height="38" CornerRadius="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" HorizontalAlignment="Center">
                        <TextBlock Text="?" FontFamily="{StaticResource AppFont}" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" PanningMode="VerticalOnly" Padding="4,4,14,6" ClipToBounds="False">
                <ContentControl Content="{Binding CurrentViewModel}" />
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
