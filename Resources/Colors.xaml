<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="AppBackgroundColor">#0D0F13</Color>
    <Color x:Key="SidebarBackgroundColor">#161A22</Color>
    <Color x:Key="SurfaceColor">#1A1F28</Color>
    <Color x:Key="SurfaceElevatedColor">#1D2330</Color>
    <Color x:Key="SurfaceHoverColor">#222939</Color>
    <Color x:Key="BorderColor">#242C3A</Color>
    <Color x:Key="DividerColor">#252C38</Color>
    <Color x:Key="PrimaryColor">#4E6BFF</Color>
    <Color x:Key="PrimaryHoverColor">#6680FF</Color>
    <Color x:Key="PrimaryMutedColor">#222D57</Color>
    <Color x:Key="TextPrimaryColor">#F7F8FC</Color>
    <Color x:Key="TextSecondaryColor">#8E99AC</Color>
    <Color x:Key="TextMutedColor">#596579</Color>
    <Color x:Key="SuccessColor">#4FEA87</Color>
    <Color x:Key="SuccessMutedColor">#173B2D</Color>
    <Color x:Key="DangerColor">#FF5C66</Color>
    <Color x:Key="WarningColor">#F8C44F</Color>

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource SidebarBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{StaticResource SurfaceElevatedColor}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}" />
    <SolidColorBrush x:Key="PrimaryMutedBrush" Color="{StaticResource PrimaryMutedColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessMutedBrush" Color="{StaticResource SuccessMutedColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />

    <LinearGradientBrush x:Key="ChargeGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#526CFF" />
        <GradientStop Offset="0.55" Color="#55C1E5" />
        <GradientStop Offset="1" Color="#4FEA87" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ChartFillBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#244C6BFF" />
        <GradientStop Offset="1" Color="#004E6BFF" />
    </LinearGradientBrush>
</ResourceDictionary>
