<UserControl x:Class="LegionPulse.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:LegionPulse.Models"
             UseLayoutRounding="True">
    <Grid Style="{StaticResource PageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="70" />
            <RowDefinition Height="230" />
            <RowDefinition Height="16" />
            <RowDefinition Height="205" />
            <RowDefinition Height="16" />
            <RowDefinition Height="74" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding GreetingTitleText}" Style="{StaticResource PageTitleText}" FontSize="29" />
                <TextBlock Text="Here's your system overview" Style="{StaticResource PageSubtitleText}" FontSize="12" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,0,12">
                <Border Width="26" Height="26" Background="{StaticResource PrimaryMutedBrush}" CornerRadius="8" Margin="0,0,8,0">
                    <TextBlock Text="&#xE950;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="LEGION PULSE" FontFamily="{StaticResource AppFont}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}">
            <Grid Margin="36,27">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="348" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="235" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="162" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid Width="150" Height="150" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Ellipse Stroke="{DynamicResource BorderBrush}" StrokeThickness="8" Margin="9" />
                        <Path Data="M 78,12 A 66,66 0 1 1 33,29" Stroke="{StaticResource ChargeGradientBrush}" StrokeThickness="8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Border Width="33" Height="22" BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="1.5" CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE850;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="3,0,0,0">
                        <TextBlock Text="{Binding BatteryPercentageText}" FontFamily="{StaticResource AppFont}" FontSize="50" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding RemainingTimeText}" FontFamily="{StaticResource AppFont}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,-3,0,7" />
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding StatusText}" FontFamily="{StaticResource AppFont}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" />
                        </StackPanel>
                        <TextBlock Text="{Binding PowerSourceText}" Style="{StaticResource MetricLabelText}" Margin="0,8,0,0" />
                    </StackPanel>
                </Grid>

                <Border Grid.Column="1" Background="{StaticResource DividerBrush}" Margin="0,0,34,0" />
                <Grid Grid.Column="2" Margin="40,0">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Battery Health" Style="{StaticResource MetricLabelText}" FontSize="14" FontWeight="Medium" />
                        <TextBlock Text="{Binding BatteryHealthText}" Style="{StaticResource MetricValueText}" FontSize="23" Foreground="{StaticResource SuccessBrush}" Margin="0,8,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Cycle Count" Style="{StaticResource MetricLabelText}" FontSize="14" FontWeight="Medium" />
                        <TextBlock Text="{Binding CycleCountText}" Style="{StaticResource MetricValueText}" FontSize="23" Margin="0,8,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="Capacity" Style="{StaticResource MetricLabelText}" FontSize="14" FontWeight="Medium" />
                        <TextBlock Text="{Binding FullCapacityWhText}" Style="{StaticResource MetricValueText}" FontSize="23" Margin="0,8,0,0" />
                    </StackPanel>
                </Grid>
                <Border Grid.Column="3" Background="{StaticResource DividerBrush}" Margin="0,0,34,0" />
                <Grid Grid.Column="4" Margin="39,0,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="CPU" Style="{StaticResource MetricLabelText}" FontSize="14" FontWeight="Medium" />
                        <TextBlock Text="{Binding CpuUsageText}" Style="{StaticResource MetricValueText}" FontSize="20" Foreground="{StaticResource PrimaryBrush}" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding CpuTempText}" Style="{StaticResource TinyLabelText}" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="GPU" Style="{StaticResource MetricLabelText}" FontSize="14" FontWeight="Medium" />
                        <TextBlock Text="{Binding GpuUsageText}" Style="{StaticResource MetricValueText}" FontSize="20" Foreground="#7184FF" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding GpuTempText}" Style="{StaticResource TinyLabelText}" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="Power" Style="{StaticResource MetricLabelText}" FontSize="14" FontWeight="Medium" />
                        <TextBlock Text="{Binding PowerDrawText}" Style="{StaticResource MetricValueText}" FontSize="20" Foreground="{StaticResource SuccessBrush}" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding ActivePerformanceModeName}" Style="{StaticResource TinyLabelText}" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardBorder}">
                <Grid Margin="20,16">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="CPU" Style="{StaticResource SectionTitleText}" FontSize="22" />
                            <TextBlock Text="{Binding CpuNameText}" Style="{StaticResource TinyLabelText}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1" VerticalAlignment="Center" Margin="0,2,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="{Binding CpuUsageText}" Style="{StaticResource MetricValueText}" FontSize="32" FontWeight="SemiBold" Margin="0,-6,0,0" /><TextBlock Text="CPU Usage" Style="{StaticResource TinyLabelText}" FontSize="13" FontWeight="Medium" Margin="0,2,0,0" /></StackPanel>
                        <StackPanel Grid.Column="1"><TextBlock Text="{Binding CpuTempText}" Style="{StaticResource MetricValueText}" FontSize="32" FontWeight="SemiBold" Margin="0,-6,0,0" /><TextBlock Text="Temp" Style="{StaticResource TinyLabelText}" FontSize="13" FontWeight="Medium" Margin="0,2,0,0" /></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="{Binding CpuClockText}" Style="{StaticResource MetricValueText}" FontSize="32" FontWeight="SemiBold" Margin="0,-6,0,0" /><TextBlock Text="Clock Speed" Style="{StaticResource TinyLabelText}" FontSize="13" FontWeight="Medium" Margin="0,2,0,0" /></StackPanel>
                    </Grid>
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                <Grid Margin="20,16">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid>
                        <StackPanel><TextBlock Text="GPU" Style="{StaticResource SectionTitleText}" FontSize="22" /><TextBlock Text="{Binding GpuNameText}" Style="{StaticResource TinyLabelText}" Margin="0,2,0,0" /></StackPanel>
                    </Grid>
                    <Grid Grid.Row="1" VerticalAlignment="Center" Margin="0,2,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="{Binding GpuVramText}" Style="{StaticResource MetricValueText}" FontSize="32" FontWeight="SemiBold" Margin="0,-6,0,0" /><TextBlock Text="VRAM" Style="{StaticResource TinyLabelText}" FontSize="13" FontWeight="Medium" Margin="0,2,0,0" /></StackPanel>
                        <StackPanel Grid.Column="1"><TextBlock Text="{Binding GpuTempText}" Style="{StaticResource MetricValueText}" FontSize="32" FontWeight="SemiBold" Margin="0,-6,0,0" /><TextBlock Text="Temp" Style="{StaticResource TinyLabelText}" FontSize="13" FontWeight="Medium" Margin="0,2,0,0" /></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="{Binding GpuClockText}" Style="{StaticResource MetricValueText}" FontSize="32" FontWeight="SemiBold" Margin="0,-6,0,0" /><TextBlock Text="{Binding GpuCoreLabelText}" Style="{StaticResource TinyLabelText}" FontSize="13" FontWeight="Medium" Margin="0,2,0,0" /></StackPanel>
                    </Grid>
                </Grid>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource CardBorder}">
                <Grid Margin="20,16">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid>
                        <StackPanel><TextBlock Text="Power" Style="{StaticResource SectionTitleText}" FontSize="22" /><TextBlock Text="{Binding ActivePerformanceModeName}" Style="{StaticResource TinyLabelText}" Margin="0,2,0,0" /></StackPanel>
                    </Grid>
                    <Grid Grid.Row="1" VerticalAlignment="Center" Margin="0,2,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="{Binding TotalCpuGpuPowerText}" Style="{StaticResource MetricValueText}" FontSize="32" FontWeight="SemiBold" Margin="0,-6,0,0" /><TextBlock Text="Total Power" Style="{StaticResource TinyLabelText}" FontSize="13" FontWeight="Medium" Margin="0,2,0,0" /></StackPanel>
                        <StackPanel Grid.Column="1"><TextBlock Text="{Binding CpuPowerText}" Style="{StaticResource MetricValueText}" FontSize="32" FontWeight="SemiBold" Margin="0,-6,0,0" /><TextBlock Text="CPU Power" Style="{StaticResource TinyLabelText}" FontSize="13" FontWeight="Medium" Margin="0,2,0,0" /></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="{Binding GpuPowerText}" Style="{StaticResource MetricValueText}" FontSize="32" FontWeight="SemiBold" Margin="0,-6,0,0" /><TextBlock Text="GPU Power" Style="{StaticResource TinyLabelText}" FontSize="13" FontWeight="Medium" Margin="0,2,0,0" /></StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="5" Style="{StaticResource CardBorder}">
            <Grid Margin="26,12"><Grid.ColumnDefinitions><ColumnDefinition Width="235" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="Performance Mode" Style="{StaticResource CardHeadingText}" /><TextBlock Text="Choose the mode that fits your use case" Style="{StaticResource TinyLabelText}" Margin="0,3,0,0" /></StackPanel><ItemsControl Grid.Column="1" ItemsSource="{Binding PerformanceModes}" HorizontalAlignment="Left" Margin="0,0,0,0" VerticalAlignment="Center"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type models:PerformanceModeOption}"><Button Style="{StaticResource ModeSegmentButton}" Margin="0,0,9,0" Content="{Binding Name}" Command="{Binding DataContext.SelectPerformanceModeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Grid>
        </Border>
    </Grid>
</UserControl>
