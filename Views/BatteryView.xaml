<UserControl x:Class="LegionPulse.Views.BatteryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Style="{StaticResource PageRoot}" MinWidth="950">
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="114" />
            <RowDefinition Height="16" />
            <RowDefinition Height="318" />
            <RowDefinition Height="16" />
            <RowDefinition Height="208" />
            <RowDefinition Height="16" />
            <RowDefinition Height="98" />
            <RowDefinition Height="16" />
            <RowDefinition Height="238" />
            <RowDefinition Height="16" />
            <RowDefinition Height="70" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Battery" Style="{StaticResource PageTitleText}" />
                <Button Style="{StaticResource IconButton}" Content="&#xE72C;" Margin="12,0,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessBrush}" Margin="0,0,7,0" />
                <TextBlock Text="{Binding StatusText}" FontFamily="{StaticResource AppFont}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" />
                <TextBlock Text="{Binding RemainingTimeText, StringFormat='·   {0}'}" Style="{StaticResource MetricLabelText}" Margin="12,0,0,0" />
            </StackPanel>
        </Grid>

        <!-- Top Main Battery Summary -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}">
            <Grid Margin="27,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="580" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="54" Height="54" Background="{StaticResource PrimaryMutedBrush}" CornerRadius="14">
                        <TextBlock Text="&#xE850;" FontFamily="{StaticResource IconFont}" FontSize="25" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="21,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding BatteryPercentageText}" FontFamily="{StaticResource AppFont}" FontSize="45" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding PowerSourceText}" Style="{StaticResource MetricLabelText}" Margin="0,-3,0,0" />
                    </StackPanel>
                </StackPanel>
                
                <Border Grid.Column="1" Background="{StaticResource DividerBrush}" />
                
                <Grid Grid.Column="2" Margin="42,0,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Status" Style="{StaticResource TinyLabelText}" />
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource MetricValueText}" Foreground="{StaticResource SuccessBrush}" Margin="0,7,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Remaining" Style="{StaticResource TinyLabelText}" />
                        <TextBlock Text="{Binding RemainingTimeText}" Style="{StaticResource MetricValueText}" Margin="0,7,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="Until Full" Style="{StaticResource TinyLabelText}" />
                        <TextBlock Text="{Binding TimeUntilFullText}" Style="{StaticResource MetricValueText}" Margin="0,7,0,0" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Row 3: Battery Health & Live Telemetry -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="395" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            
            <!-- Battery Health Card -->
            <Border Style="{StaticResource CardBorder}">
                <Grid Margin="22,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="27" />
                        <RowDefinition Height="70" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    
                    <TextBlock Text="BATTERY HEALTH" Style="{StaticResource EyebrowText}" />
                    <Grid Grid.Row="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding BatteryHealthText}" FontFamily="{StaticResource AppFont}" FontSize="46" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" />
                            <TextBlock Text="{Binding HealthStatusText}" FontFamily="{StaticResource AppFont}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Bottom" Margin="10,0,0,12" />
                        </StackPanel>
                        <Border Height="5" Background="{StaticResource DividerBrush}" CornerRadius="3" VerticalAlignment="Bottom">
                            <Border Background="{StaticResource SuccessBrush}" HorizontalAlignment="Left" CornerRadius="3" />
                        </Border>
                    </Grid>
                    
                    <Grid Grid.Row="2" Margin="0,21,0,0">
                        <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="Wear Level" Style="{StaticResource MetricLabelText}" />
                            <TextBlock Text="{Binding WearLevelText}" Style="{StaticResource MetricValueText}" FontSize="13" HorizontalAlignment="Right" />
                        </Grid>
                        <Border Grid.Row="1" Background="{StaticResource DividerBrush}" Height="1" VerticalAlignment="Top" />
                        <Grid Grid.Row="1" Margin="0,14,0,0">
                            <TextBlock Text="Cycle Count" Style="{StaticResource MetricLabelText}" />
                            <TextBlock Text="{Binding CycleCountText}" Style="{StaticResource MetricValueText}" FontSize="13" HorizontalAlignment="Right" />
                        </Grid>
                        <Border Grid.Row="2" Background="{StaticResource DividerBrush}" Height="1" VerticalAlignment="Top" />
                        <Grid Grid.Row="2" Margin="0,14,0,0">
                            <TextBlock Text="Manufacturer" Style="{StaticResource MetricLabelText}" />
                            <TextBlock Text="{Binding ManufacturerText}" Style="{StaticResource MetricValueText}" FontSize="13" HorizontalAlignment="Right" />
                        </Grid>
                        <Border Grid.Row="3" Background="{StaticResource DividerBrush}" Height="1" VerticalAlignment="Top" />
                        <Grid Grid.Row="3" Margin="0,14,0,0">
                            <TextBlock Text="Chemistry" Style="{StaticResource MetricLabelText}" />
                            <TextBlock Text="{Binding ChemistryText}" Style="{StaticResource MetricValueText}" FontSize="13" HorizontalAlignment="Right" />
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <!-- Live Telemetry Card -->
            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                <Grid Margin="22,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="27" />
                        <RowDefinition Height="30" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    
                    <TextBlock Text="LIVE STATISTICS" Style="{StaticResource EyebrowText}" />
                    <TextBlock Grid.Row="1" Text="Real-time telemetry updated every second" Style="{StaticResource TinyLabelText}" />
                    
                    <Grid Grid.Row="2" Margin="0,9,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="30" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                        
                        <StackPanel>
                            <TextBlock Text="Current Charge" Style="{StaticResource TinyLabelText}" />
                            <TextBlock Text="{Binding BatteryPercentageText}" Style="{StaticResource MetricValueText}" FontSize="17" Margin="0,6,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Voltage" Style="{StaticResource TinyLabelText}" />
                            <TextBlock Text="{Binding VoltageText}" Style="{StaticResource MetricValueText}" FontSize="17" Margin="0,6,0,0" />
                        </StackPanel>
                        
                        <Border Grid.Row="1" Background="{StaticResource DividerBrush}" Height="1" VerticalAlignment="Center" />
                        <Border Grid.Row="1" Grid.Column="2" Background="{StaticResource DividerBrush}" Height="1" VerticalAlignment="Center" />
                        
                        <StackPanel Grid.Row="1" Margin="0,11,0,0">
                            <TextBlock Text="Power Draw" Style="{StaticResource TinyLabelText}" />
                            <TextBlock Text="{Binding PowerDrawText}" Style="{StaticResource MetricValueText}" FontSize="17" Margin="0,6,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,11,0,0">
                            <TextBlock Text="Temperature" Style="{StaticResource TinyLabelText}" />
                            <TextBlock Text="{Binding BatteryTempText}" Style="{StaticResource MetricValueText}" FontSize="17" Margin="0,6,0,0" />
                        </StackPanel>
                        
                        <Border Grid.Row="2" Background="{StaticResource DividerBrush}" Height="1" VerticalAlignment="Center" />
                        <Border Grid.Row="2" Grid.Column="2" Background="{StaticResource DividerBrush}" Height="1" VerticalAlignment="Center" />
                        
                        <StackPanel Grid.Row="2" Margin="0,11,0,0">
                            <TextBlock Text="Charging Rate" Style="{StaticResource TinyLabelText}" />
                            <TextBlock Text="{Binding ChargeRateText}" Style="{StaticResource MetricValueText}" FontSize="17" Margin="0,6,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,11,0,0">
                            <TextBlock Text="Capacity Used" Style="{StaticResource TinyLabelText}" />
                            <TextBlock Text="{Binding CapacityUsedText}" Style="{StaticResource MetricValueText}" FontSize="17" Margin="0,6,0,0" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Smart Saver & Charging Info -->
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="395" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            
            <Border Style="{StaticResource CardBorder}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="22,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="25" />
                            <RowDefinition Height="36" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE945;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,8,0" />
                            <TextBlock Text="SMART BATTERY SAVER PROFILE" Style="{StaticResource EyebrowText}" />
                        </StackPanel>
                        
                        <Grid Grid.Row="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Status: " Style="{StaticResource MetricLabelText}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SmartSaverStatus}" FontFamily="{StaticResource AppFont}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        
                        <!-- Master Toggle Button -->
                        <StackPanel Grid.Row="2" Margin="0,4,0,12">
                            <Button Content="{Binding SmartSaverAction}" Command="{Binding ToggleSmartSaverCommand}" Style="{StaticResource PrimaryButton}" />
                            <TextBlock Text="{Binding EnergySaverErrorMessage}" Visibility="{Binding HasEnergySaverError, Converter={StaticResource BooleanToVisibilityConverter}}" Foreground="{DynamicResource DangerBrush}" FontFamily="{StaticResource AppFont}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>

                        <!-- Expandable Advanced Options Header -->
                        <Button Grid.Row="3" Command="{Binding ToggleAdvancedOptionsCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,0,8">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent" Padding="0,4">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding AdvancedOptionsArrow}" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Advanced Options" FontFamily="{StaticResource AppFont}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Advanced Options Panel -->
                        <StackPanel Grid.Row="4" Visibility="{Binding IsAdvancedOptionsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,4,0,0">
                            <Border Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14,12">
                                <StackPanel>
                                    <CheckBox IsChecked="{Binding ActiveProfile.EnableWindowsBatterySaver}" Content="Windows Battery Saver Scheme" Margin="0,0,0,8" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{StaticResource AppFont}" FontSize="12" />
                                    <CheckBox IsChecked="{Binding ActiveProfile.LimitRefreshRate60Hz}" Content="Set Refresh Rate to 60 Hz" Margin="0,0,0,8" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{StaticResource AppFont}" FontSize="12" />
                                    <CheckBox IsChecked="{Binding ActiveProfile.SwitchQuietThermalMode}" Content="Switch to Quiet Thermal Mode" Margin="0,0,0,8" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{StaticResource AppFont}" FontSize="12" />
                                    <CheckBox IsChecked="{Binding ActiveProfile.ReduceBrightness}" Content="Reduce Display Brightness (45%)" Margin="0,0,0,8" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{StaticResource AppFont}" FontSize="12" />
                                    <CheckBox IsChecked="{Binding ActiveProfile.DisableAlwaysOnUsb}" Content="Disable Always-On USB" IsEnabled="{Binding Capabilities.IsAlwaysOnUsbSupported}" Margin="0,0,0,8" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{StaticResource AppFont}" FontSize="12" />
                                    <CheckBox IsChecked="{Binding ActiveProfile.EnableHybridIgpuMode}" Content="Enable Hybrid / iGPU Mode" IsEnabled="{Binding Capabilities.IsHybridModeSupported}" Margin="0,0,0,8" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{StaticResource AppFont}" FontSize="12" />
                                    <CheckBox IsChecked="{Binding ActiveProfile.DisableOverdrive}" Content="Disable Display Overdrive" IsEnabled="{Binding Capabilities.IsOverdriveSupported}" Margin="0,0,0,8" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{StaticResource AppFont}" FontSize="12" />
                                    <CheckBox IsChecked="{Binding ActiveProfile.DisableCpuTurboBoost}" Content="Disable CPU Turbo Boost" Margin="0,0,0,8" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{StaticResource AppFont}" FontSize="12" />

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="Apply Selected" Command="{Binding ApplyCustomProfileCommand}" Style="{StaticResource PrimaryButton}" Height="32" FontSize="11" />
                                        <Button Grid.Column="2" Content="Select All" Command="{Binding SelectAllOptionsCommand}" Style="{StaticResource ModeSegmentButton}" Height="32" FontSize="11" MinWidth="0" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                <Grid Margin="22,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="31" />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    
                    <TextBlock Text="HARDWARE SPECIFICATIONS" Style="{StaticResource EyebrowText}" />
                    
                    <Grid Grid.Row="1">
                        <TextBlock Text="Design Capacity" Style="{StaticResource MetricLabelText}" />
                        <TextBlock Text="{Binding DesignCapacityText}" Style="{StaticResource MetricValueText}" FontSize="13" HorizontalAlignment="Right" />
                    </Grid>
                    <Border Grid.Row="2" Background="{StaticResource DividerBrush}" Height="1" VerticalAlignment="Top" />
                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <TextBlock Text="Full Charge Capacity" Style="{StaticResource MetricLabelText}" />
                        <TextBlock Text="{Binding FullCapacityText}" Style="{StaticResource MetricValueText}" FontSize="13" HorizontalAlignment="Right" />
                    </Grid>
                    <Border Grid.Row="3" Background="{StaticResource DividerBrush}" Height="1" VerticalAlignment="Top" />
                    <Grid Grid.Row="3" Margin="0,12,0,0">
                        <TextBlock Text="Serial Number" Style="{StaticResource MetricLabelText}" />
                        <TextBlock Text="{Binding SerialNumberText}" Style="{StaticResource MetricValueText}" FontSize="13" HorizontalAlignment="Right" />
                    </Grid>
                    <Border Grid.Row="4" Background="{StaticResource DividerBrush}" Height="1" VerticalAlignment="Top" />
                    <Grid Grid.Row="4" Margin="0,12,0,0">
                        <TextBlock Text="Power Source" Style="{StaticResource MetricLabelText}" />
                        <TextBlock Text="{Binding PowerSourceText}" Style="{StaticResource MetricValueText}" FontSize="13" HorizontalAlignment="Right" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Battery Timeline Card -->
        <Border Grid.Row="7" Style="{StaticResource CardBorder}">
            <Grid Margin="22,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="24" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                
                <TextBlock Text="BATTERY TIMELINE" Style="{StaticResource EyebrowText}" />
                
                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="65" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="140" />
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Status" Style="{StaticResource TinyLabelText}" />
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource MetricValueText}" FontSize="12" Margin="0,2,0,0" />
                    </StackPanel>
                    
                    <Grid Grid.Column="1" VerticalAlignment="Center" Height="10" Margin="10,0">
                        <Border Background="{StaticResource DividerBrush}" CornerRadius="5" />
                        <Border Background="{StaticResource ChargeGradientBrush}" CornerRadius="5" HorizontalAlignment="Left" Width="200" />
                    </Grid>

                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="Estimated Full / Remaining" Style="{StaticResource TinyLabelText}" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding TimeUntilFullText}" Style="{StaticResource MetricValueText}" FontSize="13" HorizontalAlignment="Right" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Battery History Section (Today / Week / Month) -->
        <Border Grid.Row="9" Style="{StaticResource CardBorder}">
            <Grid Margin="22,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="34" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="24" />
                </Grid.RowDefinitions>
                
                <Grid>
                    <TextBlock Text="BATTERY HISTORY" Style="{StaticResource EyebrowText}" VerticalAlignment="Center" />
                    
                    <!-- Timeframe Period Selector Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource ModeSegmentButton}" 
                                Content="Today" Height="30" MinWidth="65" FontSize="12" Margin="0,0,6,0"
                                Command="{Binding SelectPeriodCommand}" CommandParameter="Today" />
                        <Button Style="{StaticResource ModeSegmentButton}" 
                                Content="Week" Height="30" MinWidth="65" FontSize="12" Margin="0,0,6,0"
                                Command="{Binding SelectPeriodCommand}" CommandParameter="Week" />
                        <Button Style="{StaticResource ModeSegmentButton}" 
                                Content="Month" Height="30" MinWidth="65" FontSize="12"
                                Command="{Binding SelectPeriodCommand}" CommandParameter="Month" />
                    </StackPanel>
                </Grid>

                <!-- Chart Canvas or Empty State -->
                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <!-- When History Exists -->
                    <Viewbox Stretch="Fill" Visibility="{Binding HasHistory, Converter={StaticResource BoolToVis}}">
                        <Grid Width="1000" Height="115">
                            <Path Data="{Binding ChartFillData}" Fill="{StaticResource ChartFillBrush}" />
                            <Path Data="{Binding ChartPathData}" Stroke="{StaticResource PrimaryBrush}" StrokeThickness="2.5" Fill="Transparent" />
                        </Grid>
                    </Viewbox>

                    <!-- Empty Chart State (When no historical data recorded yet) -->
                    <Border Visibility="{Binding HasNoHistory, Converter={StaticResource BoolToVis}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="24" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,6" />
                            <TextBlock Text="No battery history available." Style="{StaticResource PageSubtitleText}" FontSize="13" HorizontalAlignment="Center" />
                            <TextBlock Text="History is automatically recorded periodically while Legion Pulse runs." Style="{StaticResource TinyLabelText}" HorizontalAlignment="Center" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Time Axis Labels -->
                <ItemsControl Grid.Row="2" ItemsSource="{Binding HistoryTimeLabels}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Style="{StaticResource TinyLabelText}" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- Bottom Tip Banner -->
        <Border Grid.Row="11" Style="{StaticResource CardBorder}">
            <Grid Margin="20,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Border Width="28" Height="28" Background="{StaticResource PrimaryMutedBrush}" CornerRadius="8">
                    <TextBlock Text="&#xE945;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{StaticResource WarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Battery Health Tip" FontFamily="{StaticResource AppFont}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" />
                    <TextBlock Text="Keeping your battery between 20% and 80% charge level can extend long-term capacity." Style="{StaticResource MetricLabelText}" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
