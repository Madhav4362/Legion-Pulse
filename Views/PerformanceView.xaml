<UserControl x:Class="LegionPulse.Views.PerformanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:LegionPulse.Models"
             UseLayoutRounding="True">
    <Grid Style="{StaticResource PageRoot}">
        <Grid.RowDefinitions><RowDefinition Height="80" /><RowDefinition Height="182" /><RowDefinition Height="18" /><RowDefinition Height="250" /><RowDefinition Height="18" /><RowDefinition Height="115" /></Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <StackPanel VerticalAlignment="Center"><TextBlock Text="Performance" Style="{StaticResource PageTitleText}" /><TextBlock Text="Monitor your laptop performance and thermals in real time." Style="{StaticResource PageSubtitleText}" Margin="0,4,0,0" /></StackPanel>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Ellipse Width="6" Height="6" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,6,0" /><TextBlock Text="Live" FontFamily="{StaticResource AppFont}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" /><Button Style="{StaticResource IconButton}" Content="&#xE72C;" VerticalAlignment="Center" Margin="12,0,0,0" /></StackPanel><TextBlock Text="Updates every second" Style="{StaticResource TinyLabelText}" HorizontalAlignment="Right" Margin="0,1,0,0" /></StackPanel>
        </Grid>
        <Border Grid.Row="1" Style="{StaticResource CardBorder}"><Grid Margin="31,27"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="1" /><ColumnDefinition /><ColumnDefinition Width="1" /><ColumnDefinition /><ColumnDefinition Width="1" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center"><TextBlock Text="CPU" Style="{StaticResource PageSubtitleText}" FontWeight="SemiBold" /><TextBlock Text="{Binding CpuUsageText}" FontFamily="{StaticResource AppFont}" FontSize="50" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,5,0,0" /><TextBlock Text="{Binding CpuTempText}" FontFamily="{StaticResource AppFont}" FontSize="21" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,0" /></StackPanel>
            <Border Grid.Column="1" Background="{StaticResource DividerBrush}" Margin="0,7" />
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="31,0"><TextBlock Text="GPU" Style="{StaticResource PageSubtitleText}" FontWeight="SemiBold" /><TextBlock Text="{Binding GpuUsageText}" FontFamily="{StaticResource AppFont}" FontSize="50" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,5,0,0" /><TextBlock Text="{Binding GpuTempText}" FontFamily="{StaticResource AppFont}" FontSize="21" Foreground="{StaticResource TextSecondaryBrush}" /></StackPanel>
            <Border Grid.Column="3" Background="{StaticResource DividerBrush}" Margin="0,7" />
            <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="31,0"><TextBlock Text="Memory" Style="{StaticResource PageSubtitleText}" FontWeight="SemiBold" /><TextBlock Text="{Binding MemoryUsedText}" FontFamily="{StaticResource AppFont}" FontSize="50" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,5,0,0" /><TextBlock Text="{Binding MemoryUsagePercentText}" FontFamily="{StaticResource AppFont}" FontSize="21" Foreground="{StaticResource TextSecondaryBrush}" /></StackPanel>
            <Border Grid.Column="5" Background="{StaticResource DividerBrush}" Margin="0,7" />
            <StackPanel Grid.Column="6" VerticalAlignment="Center" Margin="31,0"><TextBlock Text="Power" Style="{StaticResource PageSubtitleText}" FontWeight="SemiBold" /><TextBlock Text="{Binding PowerDrawText}" FontFamily="{StaticResource AppFont}" FontSize="50" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,5,0,0" /><TextBlock Text="{Binding PowerBreakdownText}" FontFamily="{StaticResource AppFont}" FontSize="15" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" /></StackPanel>
        </Grid></Border>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="18" /><ColumnDefinition /><ColumnDefinition Width="18" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardBorder}">
                <Grid Margin="20,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="54" />
                        <RowDefinition Height="46" />
                        <RowDefinition Height="46" />
                        <RowDefinition Height="46" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="CPU" Style="{StaticResource SectionTitleText}" />
                        <TextBlock Text="{Binding CpuNameText}" Style="{StaticResource TinyLabelText}" Margin="0,1,0,0" />
                    </StackPanel>
                    <Grid Grid.Row="1" VerticalAlignment="Center">
                        <TextBlock Text="Usage" Style="{StaticResource MetricLabelText}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CpuUsageText}" Style="{StaticResource MetricValueText}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Grid.Row="2">
                        <Border Background="{StaticResource DividerBrush}" Height="1" VerticalAlignment="Top" />
                        <Grid VerticalAlignment="Center" Margin="0,4,0,0">
                            <TextBlock Text="Temperature" Style="{StaticResource MetricLabelText}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CpuTempText}" Style="{StaticResource MetricValueText}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                    <Grid Grid.Row="3">
                        <Border Background="{StaticResource DividerBrush}" Height="1" VerticalAlignment="Top" />
                        <Grid VerticalAlignment="Center" Margin="0,4,0,0">
                            <TextBlock Text="Clock Speed" Style="{StaticResource MetricLabelText}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CpuClockText}" Style="{StaticResource MetricValueText}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                <Grid Margin="20,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="54" />
                        <RowDefinition Height="46" />
                        <RowDefinition Height="46" />
                        <RowDefinition Height="46" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="GPU" Style="{StaticResource SectionTitleText}" />
                        <TextBlock Text="{Binding GpuNameText}" Style="{StaticResource TinyLabelText}" Margin="0,1,0,0" />
                    </StackPanel>
                    <Grid Grid.Row="1" VerticalAlignment="Center">
                        <TextBlock Text="Usage" Style="{StaticResource MetricLabelText}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding GpuUsageText}" Style="{StaticResource MetricValueText}" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Grid.Row="2">
                        <Border Background="{StaticResource DividerBrush}" Height="1" VerticalAlignment="Top" />
                        <Grid VerticalAlignment="Center" Margin="0,4,0,0">
                            <TextBlock Text="Temperature" Style="{StaticResource MetricLabelText}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding GpuTempText}" Style="{StaticResource MetricValueText}" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                    <Grid Grid.Row="3">
                        <Border Background="{StaticResource DividerBrush}" Height="1" VerticalAlignment="Top" />
                        <Grid VerticalAlignment="Center" Margin="0,4,0,0">
                            <TextBlock Text="VRAM Used" Style="{StaticResource MetricLabelText}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding GpuVramText}" Style="{StaticResource MetricValueText}" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource CardBorder}">
                <Grid Margin="20,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="54" />
                        <RowDefinition Height="46" />
                        <RowDefinition Height="46" />
                        <RowDefinition Height="46" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="System &amp; Power" Style="{StaticResource SectionTitleText}" />
                        <TextBlock Text="{Binding SystemModelNameText}" Style="{StaticResource TinyLabelText}" Margin="0,1,0,0" />
                    </StackPanel>
                    <Grid Grid.Row="1" VerticalAlignment="Center">
                        <TextBlock Text="CPU / GPU Power" Style="{StaticResource MetricLabelText}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding PowerBreakdownText}" Style="{StaticResource MetricValueText}" FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Grid.Row="2">
                        <Border Background="{StaticResource DividerBrush}" Height="1" VerticalAlignment="Top" />
                        <Grid VerticalAlignment="Center" Margin="0,4,0,0">
                            <TextBlock Text="Total Power Draw" Style="{StaticResource MetricLabelText}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding PowerDrawText}" Style="{StaticResource MetricValueText}" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                    <Grid Grid.Row="3">
                        <Border Background="{StaticResource DividerBrush}" Height="1" VerticalAlignment="Top" />
                        <Grid VerticalAlignment="Center" Margin="0,4,0,0">
                            <TextBlock Text="Cooling" Style="{StaticResource MetricLabelText}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ThermalStateText}" Style="{StaticResource MetricValueText}" FontSize="14" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Row="5" Style="{StaticResource CardBorder}"><Grid Margin="24,18"><Grid.ColumnDefinitions><ColumnDefinition Width="540" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="Performance Mode" Style="{StaticResource SectionTitleText}" /><TextBlock Text="Choose the mode that best matches your current workload." Style="{StaticResource PageSubtitleText}" FontSize="13" Margin="0,3,0,0" TextWrapping="Wrap" /></StackPanel><ItemsControl Grid.Column="1" ItemsSource="{Binding PerformanceModes}" HorizontalAlignment="Right" VerticalAlignment="Center"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type models:PerformanceModeOption}"><Button Style="{StaticResource ModeSegmentButton}" MinWidth="94" Margin="0,0,10,0" Content="{Binding Name}" Command="{Binding DataContext.SelectPerformanceModeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Grid></Border>
    </Grid>
</UserControl>
